# ── secrets & runtime state — NEVER commit ──
# NOTE: gitignore has no trailing comments — a "#" after a pattern becomes part of
# the pattern, so it silently matches nothing. Keep every comment on its own line.

# hot-wallet WIF, hmac_secret, pushplus_token
config.json
# claim history + visitor IPs
faucet.db
faucet.db-wal
faucet.db-shm
# cross-process mutexes (runtime)
payout.lock
payout.lock-journal
ln.lock
ln.lock-journal
# LND macaroon + tls.cert copied in at deploy time
lnd/
*.macaroon
*.key
*.crt
*.pem
*.evidence
server.log

# python
__pycache__/
*.pyc
*.pyo
venv/
.venv/
env/

# local key backups / anything with "backup" in the name
*backup*
*备份*
HOTWALLET*
keys_scan*
